# Server environment (never commit real values)
PORT=8787
NODE_ENV=development

# OpenAI (server-side only — do NOT put this in the client / VITE_ vars)
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# Resend transactional email
RESEND_API_KEY=re_...
RESEND_FROM=Themis <onboarding@resend.dev>
CONTACT_EMAIL=molonkunuku@gmail.com

# Public URL of the app (used in email links)
APP_URL=http://localhost:5173

# Postgres (Render). Leave blank locally to use the in-memory store.
DATABASE_URL=

# Comma-separated EXTRA allowed browser origins for CORS.
# The app's own onrender.com origins + localhost are always allowed regardless.
CLIENT_ORIGIN=

# Max AI analyses per IP per minute (rate limiter is separate)
DAILY_ANALYSIS_CAP=25
