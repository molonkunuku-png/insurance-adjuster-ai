# Server environment (never commit real values)
PORT=8787
NODE_ENV=development

# OpenAI (server-side only — do NOT put this in the client / VITE_ vars)
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# Resend transactional email
RESEND_API_KEY=re_...
RESEND_FROM=Themis <onboarding@resend.dev>
CONTACT_EMAIL=molonkunuku@gmail.com

# Public URL of the app (used in email links + post-verify redirect)
APP_URL=http://localhost:5173

# Public base URL of the API itself. Defaults to APP_URL (single-service deploy).
# Only set this when the static site and API are separate services.
PUBLIC_API_URL=

# Postgres (Render). Leave blank locally to use the in-memory store.
DATABASE_URL=

# Comma-separated EXTRA allowed browser origins for CORS.
# The app's own onrender.com origins + localhost are always allowed regardless.
CLIENT_ORIGIN=

# Max AI analyses per IP per minute (rate limiter is separate)
DAILY_ANALYSIS_CAP=25

# Beta access (REQUIRED in production).
# SESSION_SECRET: long random string used to sign session cookies.
#   generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# ADMIN_SECRET: secret for the admin endpoints (send as x-admin-secret header).
ADMIN_SECRET=
# How many people get instant access before the waitlist kicks in.
BETA_LIMIT=10
TOKEN_TTL_DAYS=7
SESSION_TTL_DAYS=7
