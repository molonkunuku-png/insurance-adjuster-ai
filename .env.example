# Client environment (Vite). These are bundled and PUBLIC — never put secrets here.
#
# Only needed when the API runs on a different origin than the site
# (i.e. two separate Render services). For local dev against the API:
VITE_API_URL=http://localhost:8787
#
# Leave blank/unspecified when the API serves the site (single Render service).

# --- Server environment (Render env vars; NEVER commit values) ---
# Mail engine provider order: gmail (own SMTP) -> resend -> file log.
# EMAIL_PROVIDER is informational today; EMAIL_ENABLED=false halts all sends.
# EMAIL_PROVIDER=gmail
# EMAIL_ENABLED=true
#
# Gmail relay (no verified domain needed; needs App Password + 2SV):
# GMAIL_USER=themis.beta@gmail.com
# GMAIL_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx
# MAIL_FROM=themis.beta@gmail.com
# MAIL_FROM_NAME=Themis Adjuster AI
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# Test-only plaintext SMTP against a local dummy (NEVER in production):
# SMTP_ALLOW_PLAIN=1
#
# Optional DKIM signing (no benefit until the DNS TXT publishes):
# DKIM_DOMAIN=
# DKIM_SELECTOR=themis
# DKIM_PRIVATE_KEY=
#
# Telegram channel (bot token only, no domain needed):
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_ENABLED=true
#
# Break-glass emergency login mint (disabled unless exactly '1'):
# BREAK_GLASS=0
#
# Existing knobs: SESSION_SECRET, ADMIN_SECRET, DATABASE_URL, RESEND_API_KEY,
# RESEND_FROM, CONTACT_EMAIL, APP_URL, PUBLIC_API_URL, BETA_LIMIT,
# TOKEN_TTL_DAYS=2, SESSION_TTL_DAYS=7, DAILY_ANALYSIS_CAP=25, PORT=8787
